<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.entidaddesconocida</groupId>
    <artifactId>monte_erp</artifactId>
    <version>1.0-SNAPSHOT</version>
    <name>monte_erp</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.12.1</junit.version>
        <testfx.version>4.0.18</testfx.version>
        <mysql.image>mysql:8.0</mysql.image>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>21.0.6</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>21.0.6</version>
        </dependency>
        <!-- Only needed by the UI test support (UiScreenshots converts a
             JavaFX snapshot to BufferedImage through SwingFXUtils). Test scope
             keeps it out of the shaded JAR and out of the module path. -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-swing</artifactId>
            <version>21.0.6</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.controlsfx</groupId>
            <artifactId>controlsfx</artifactId>
            <version>11.2.1</version>
        </dependency>
        <dependency>
            <groupId>net.synedra</groupId>
            <artifactId>validatorfx</artifactId>
            <version>0.6.1</version>
            <exclusions>
                <exclusion>
                    <groupId>org.openjfx</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- MySQL JDBC driver. The JAR ships no module-info.class: its automatic
             module name is derived from the artifact name (mysql.connector.j). -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>8.4.0</version>
        </dependency>
        <!-- OS keyring access (Credential Manager / Keychain / Secret Service).
             The JAR ships no module-info.class nor Automatic-Module-Name, so its
             automatic module name is derived from the file name: java.keyring. -->
        <dependency>
            <groupId>com.github.javakeyring</groupId>
            <artifactId>java-keyring</artifactId>
            <version>1.0.4</version>
        </dependency>
        <!-- PDF export of the reports (RF-12). OpenPDF ships an
             Automatic-Module-Name (com.github.librepdf.openpdf) but no
             module-info.class, so it is used as an automatic module. Its
             LGPL/MPL 2.0 licence allows shipping it with the application. -->
        <dependency>
            <groupId>com.github.librepdf</groupId>
            <artifactId>openpdf</artifactId>
            <version>2.0.3</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <!--
            UI tests (TestFX + Testcontainers). They are excluded from the
            default `mvn test` run and only run under the `ui-tests` profile,
            which expects an X display (see scripts/run-ui-tests.sh).
        -->
        <dependency>
            <groupId>org.testfx</groupId>
            <artifactId>testfx-core</artifactId>
            <version>${testfx.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testfx</groupId>
            <artifactId>testfx-junit5</artifactId>
            <version>${testfx.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>de.saxsys</groupId>
            <artifactId>mvvmfx</artifactId>
            <version>1.8.0</version>
        </dependency>
        <!-- slf4j-api 1.7.12 (transitiva de mvvmfx) no declara Automatic-Module-Name;
             se fija 1.7.36 (org.slf4j) y se añade el puente a java.util.logging para
             que los logs de mvvmFX salgan por el mismo Logger del proyecto. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>1.7.36</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-jdk14</artifactId>
            <version>1.7.36</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.15</version> <!-- Usa la última versión disponible -->
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <!--
                                Al fusionar JARs firmados (p. ej. at.favre.lib:hkdf,
                                transitivo de java-keyring) hay que descartar sus
                                ficheros de firma: la firma original deja de ser
                                valida para el JAR sombreado y la JVM aborta con
                                "Invalid signature file digest for Manifest main
                                attributes".
                            -->
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/*.EC</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.entidaddesconocida.monte_erp.Launcher</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <!-- Tests run on the classpath: the module does not need to
                         declare a read edge to JUnit in module-info.java. -->
                    <useModulePath>false</useModulePath>
                    <!-- UI tests need Docker and an X display, so they are opt-in
                         through the `ui-tests` profile. -->
                    <excludedGroups>ui</excludedGroups>
                    <forkCount>1</forkCount>
                    <reuseForks>true</reuseForks>
                    <systemPropertyVariables>
                        <user.language>es</user.language>
                        <user.country>ES</user.country>
                        <user.timezone>Europe/Madrid</user.timezone>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>25</source>
                    <target>25</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <executions>
                    <execution>
                        <!-- Default configuration for running with: mvn clean javafx:run -->
                        <id>default-cli</id>
                        <configuration>
                            <mainClass>
                                com.entidaddesconocida.monte_erp/com.entidaddesconocida.monte_erp.MonteErpApplication
                            </mainClass>
                            <launcher>app</launcher>
                            <jlinkZipName>app</jlinkZipName>
                            <jlinkImageName>app</jlinkImageName>
                            <noManPages>true</noManPages>
                            <stripDebug>true</stripDebug>
                            <noHeaderFiles>true</noHeaderFiles>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            UI tests: TestFX over an X display (Xvfb in CI) against a throwaway
            MySQL container seeded with db/seed/demo_seed.sql.

                scripts/run-ui-tests.sh
                # or, with a display already available:
                ./mvnw verify -Pui-tests
        -->
        <profile>
            <id>ui-tests</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>3.5.2</version>
                        <configuration>
                            <!-- combine.self="override" drops the base `ui`
                                 exclusion so unit + UI tests run together. -->
                            <excludedGroups combine.self="override"/>
                            <systemPropertyVariables>
                                <user.language>es</user.language>
                                <user.country>ES</user.country>
                                <user.timezone>Europe/Madrid</user.timezone>
                                <java.awt.headless>false</java.awt.headless>
                                <testfx.robot>glass</testfx.robot>
                                <testfx.setup.timeout>20000</testfx.setup.timeout>
                                <prism.order>sw</prism.order>
                            </systemPropertyVariables>
                            <!-- JaCoCo writes the agent arguments to the
                                 `argLine` property; keep them. -->
                            <argLine>@{argLine} -Dtestfx.robot=glass -Dprism.order=sw -Dtestfx.setup.timeout=20000</argLine>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>