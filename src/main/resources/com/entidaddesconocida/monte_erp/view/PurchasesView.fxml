<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.controlsfx.control.SearchableComboBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.entidaddesconocida.monte_erp.view.PurchasesView"
            stylesheets="@../../../../css/app.css"
            styleClass="root-pane"
            prefWidth="1280.0" prefHeight="720.0">

    <top>
        <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="12.0">
            <padding>
                <Insets top="14.0" right="18.0" bottom="14.0" left="18.0"/>
            </padding>
            <Label text="Monte ERP" styleClass="topbar-title"/>
            <Label text="· Gestión de compras" styleClass="topbar-caption"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Volver" onAction="#onBack" styleClass="secondary-button"/>
        </HBox>
    </top>

    <center>
        <HBox spacing="18.0">
            <padding>
                <Insets top="18.0" right="18.0" bottom="18.0" left="18.0"/>
            </padding>

            <VBox styleClass="card" spacing="10.0" HBox.hgrow="ALWAYS">
                <padding>
                    <Insets top="18.0" right="18.0" bottom="18.0" left="18.0"/>
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label text="Compras" styleClass="section-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Actualizar" onAction="#onRefresh" styleClass="secondary-button"/>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <DatePicker fx:id="fromDatePicker" promptText="Desde" prefWidth="125.0"/>
                    <Label text="–" styleClass="subtitle"/>
                    <DatePicker fx:id="toDatePicker" promptText="Hasta" prefWidth="125.0"/>
                    <SearchableComboBox fx:id="supplierFilterCombo" promptText="Todos los proveedores"
                                        prefWidth="180.0"/>
                    <SearchableComboBox fx:id="statusFilterCombo" promptText="Todos los estados"
                                        prefWidth="160.0"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Limpiar filtros" onAction="#onClearFilters"
                            styleClass="secondary-button"/>
                </HBox>

                <TableView fx:id="purchasesTable" VBox.vgrow="ALWAYS">
                    <placeholder>
                        <Label text="No hay compras con los filtros seleccionados."/>
                    </placeholder>
                    <columns>
                        <TableColumn fx:id="purchaseIdColumn" text="Compra" prefWidth="80.0"/>
                        <TableColumn fx:id="purchaseDateColumn" text="Fecha" prefWidth="150.0"/>
                        <TableColumn fx:id="supplierColumn" text="Proveedor" prefWidth="200.0"/>
                        <TableColumn fx:id="statusColumn" text="Estado" prefWidth="100.0"/>
                        <TableColumn fx:id="totalColumn" text="Total" prefWidth="100.0"/>
                        <TableColumn fx:id="actionsColumn" text="Acciones" prefWidth="230.0"
                                     sortable="false" reorderable="false"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                    </columnResizePolicy>
                </TableView>

                <Label text="Lotes de la compra" styleClass="section-title"/>

                <TableView fx:id="purchaseLotsTable" prefHeight="180.0" minHeight="120.0">
                    <placeholder>
                        <Label text="Selecciona una compra para ver sus lotes."/>
                    </placeholder>
                    <columns>
                        <TableColumn fx:id="lotProductColumn" text="Producto" prefWidth="240.0"/>
                        <TableColumn fx:id="lotQuantityColumn" text="Cantidad" prefWidth="90.0"/>
                        <TableColumn fx:id="lotPurchasePriceColumn" text="Precio compra" prefWidth="110.0"/>
                        <TableColumn fx:id="lotSubtotalColumn" text="Subtotal" prefWidth="110.0"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                    </columnResizePolicy>
                </TableView>

                <Label fx:id="detailErrorLabel" styleClass="error" wrapText="true"/>
                <Label fx:id="detailStatusLabel" styleClass="success" wrapText="true"/>
            </VBox>

            <VBox styleClass="card" spacing="8.0" prefWidth="360.0" minWidth="330.0">
                <padding>
                    <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
                </padding>

                <Label text="Nueva compra" styleClass="title"/>
                <Label text="Cada línea genera un lote disponible en el stock."
                       styleClass="subtitle" wrapText="true"/>

                <Label text="Proveedor" styleClass="field-label">
                    <VBox.margin>
                        <Insets top="6.0"/>
                    </VBox.margin>
                </Label>
                <SearchableComboBox fx:id="supplierCombo" promptText="selecciona un proveedor"
                          maxWidth="Infinity"/>

                <Label text="Producto" styleClass="field-label">
                    <VBox.margin>
                        <Insets top="4.0"/>
                    </VBox.margin>
                </Label>
                <SearchableComboBox fx:id="productCombo" promptText="selecciona un producto"
                          maxWidth="Infinity"/>

                <Label text="Cantidad" styleClass="field-label">
                    <VBox.margin>
                        <Insets top="4.0"/>
                    </VBox.margin>
                </Label>
                <TextField fx:id="quantityField" promptText="unidades" maxWidth="Infinity"/>

                <Label text="Precio de compra" styleClass="field-label">
                    <VBox.margin>
                        <Insets top="4.0"/>
                    </VBox.margin>
                </Label>
                <TextField fx:id="purchasePriceField" promptText="precio por unidad"
                           maxWidth="Infinity"/>

                <Button text="Añadir lote" onAction="#onAddLot" maxWidth="Infinity"
                        styleClass="secondary-button">
                    <VBox.margin>
                        <Insets top="4.0"/>
                    </VBox.margin>
                </Button>

                <TableView fx:id="draftLotsTable" prefHeight="200.0" minHeight="140.0"
                           VBox.vgrow="ALWAYS">
                    <placeholder>
                        <Label text="Añade al menos un lote a la compra."/>
                    </placeholder>
                    <columns>
                        <TableColumn fx:id="draftProductColumn" text="Producto" prefWidth="150.0"/>
                        <TableColumn fx:id="draftQuantityColumn" text="Cant." prefWidth="55.0"/>
                        <TableColumn fx:id="draftPurchasePriceColumn" text="Precio" prefWidth="80.0"/>
                        <TableColumn fx:id="draftSubtotalColumn" text="Subtotal" prefWidth="85.0"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                    </columnResizePolicy>
                </TableView>

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Button text="Quitar lote" onAction="#onRemoveLot" styleClass="secondary-button"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="totalLabel" styleClass="section-title"/>
                </HBox>

                <Label fx:id="errorLabel" styleClass="error" wrapText="true"/>
                <Label fx:id="statusLabel" styleClass="success" wrapText="true"/>

                <Button text="Guardar compra" onAction="#onSave" defaultButton="true"
                        maxWidth="Infinity" styleClass="primary-button"/>
                <Button text="Nueva compra" onAction="#onNewPurchase"
                        maxWidth="Infinity" styleClass="secondary-button"/>
            </VBox>
        </HBox>
    </center>

    <bottom>
        <HBox styleClass="statusbar" alignment="CENTER_LEFT">
            <padding>
                <Insets top="8.0" right="18.0" bottom="8.0" left="18.0"/>
            </padding>
            <Label fx:id="countLabel" styleClass="statusbar-text"/>
        </HBox>
    </bottom>
</BorderPane>
