<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.entidaddesconocida.monte_erp.view.ReportsView"
            stylesheets="@../../../../css/app.css"
            styleClass="root-pane"
            prefWidth="1180.0" prefHeight="720.0">

    <top>
        <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="12.0">
            <padding>
                <Insets top="14.0" right="18.0" bottom="14.0" left="18.0"/>
            </padding>
            <Label text="Monte ERP" styleClass="topbar-title"/>
            <Label text="· Informes" styleClass="topbar-caption"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Volver" onAction="#onBack" styleClass="secondary-button"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="14.0">
            <padding>
                <Insets top="18.0" right="18.0" bottom="18.0" left="18.0"/>
            </padding>

            <HBox styleClass="card" alignment="CENTER_LEFT" spacing="12.0">
                <padding>
                    <Insets top="14.0" right="18.0" bottom="14.0" left="18.0"/>
                </padding>
                <Label text="Período" styleClass="field-label"/>
                <DatePicker fx:id="fromPicker" promptText="Desde"/>
                <Label text="–" styleClass="subtitle"/>
                <DatePicker fx:id="toPicker" promptText="Hasta"/>
                <Button text="Generar" onAction="#onGenerate" styleClass="primary-button"/>
                <Button text="Limpiar" onAction="#onClear" styleClass="secondary-button"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Sin fechas se muestra todo el histórico."
                       styleClass="subtitle" wrapText="true"/>
            </HBox>

            <Label fx:id="errorLabel" styleClass="error" wrapText="true"/>

            <TabPane fx:id="reportsTabPane" styleClass="reports-tab-pane" tabClosingPolicy="UNAVAILABLE"
                     VBox.vgrow="ALWAYS">
                <tabs>
                    <Tab text="Stock por lotes">
                        <content>
                            <VBox spacing="10.0">
                                <padding>
                                    <Insets top="14.0" right="14.0" bottom="14.0" left="14.0"/>
                                </padding>
                                <Label text="Cada fila es un lote: el valor usa las unidades disponibles."
                                       styleClass="subtitle" wrapText="true"/>
                                <TableView fx:id="stockLotsTable" VBox.vgrow="ALWAYS">
                                    <placeholder>
                                        <Label text="No hay lotes en el período seleccionado."/>
                                    </placeholder>
                                    <columns>
                                        <TableColumn fx:id="stockProductColumn" text="Producto" prefWidth="230.0"/>
                                        <TableColumn fx:id="stockSkuColumn" text="SKU" prefWidth="110.0"/>
                                        <TableColumn fx:id="stockEntryDateColumn" text="Entrada" prefWidth="150.0"/>
                                        <TableColumn fx:id="stockInitialColumn" text="Inicial" prefWidth="80.0"/>
                                        <TableColumn fx:id="stockAvailableColumn" text="Disponible" prefWidth="90.0"/>
                                        <TableColumn fx:id="stockPurchasePriceColumn" text="P. compra" prefWidth="100.0"/>
                                        <TableColumn fx:id="stockPurchaseColumn" text="Compra" prefWidth="80.0"/>
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                                    </columnResizePolicy>
                                </TableView>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <Label fx:id="stockTotalsLabel" styleClass="section-title"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button text="Exportar CSV" onAction="#onExportStock"
                                            styleClass="secondary-button"/>
                                </HBox>
                            </VBox>
                        </content>
                    </Tab>
                    <Tab text="Ventas por producto">
                        <content>
                            <VBox spacing="10.0">
                                <padding>
                                    <Insets top="14.0" right="14.0" bottom="14.0" left="14.0"/>
                                </padding>
                                <Label text="Unidades e importe por producto; los pedidos cancelados no cuentan."
                                       styleClass="subtitle" wrapText="true"/>
                                <TableView fx:id="salesTable" VBox.vgrow="ALWAYS">
                                    <placeholder>
                                        <Label text="No hay ventas en el período seleccionado."/>
                                    </placeholder>
                                    <columns>
                                        <TableColumn fx:id="salesProductColumn" text="Producto" prefWidth="320.0"/>
                                        <TableColumn fx:id="salesSkuColumn" text="SKU" prefWidth="150.0"/>
                                        <TableColumn fx:id="salesUnitsColumn" text="Unidades vendidas" prefWidth="150.0"/>
                                        <TableColumn fx:id="salesRevenueColumn" text="Importe" prefWidth="150.0"/>
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                                    </columnResizePolicy>
                                </TableView>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <Label fx:id="salesTotalsLabel" styleClass="section-title"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button text="Exportar CSV" onAction="#onExportSales"
                                            styleClass="secondary-button"/>
                                </HBox>
                            </VBox>
                        </content>
                    </Tab>
                </tabs>
            </TabPane>
        </VBox>
    </center>

    <bottom>
        <HBox styleClass="statusbar" alignment="CENTER_LEFT">
            <padding>
                <Insets top="8.0" right="18.0" bottom="8.0" left="18.0"/>
            </padding>
            <Label fx:id="countLabel" styleClass="statusbar-text"/>
        </HBox>
    </bottom>
</BorderPane>
