<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.entidaddesconocida.monte_erp.view.StockView"
            stylesheets="@../../../../css/app.css"
            styleClass="root-pane"
            prefWidth="1180.0" prefHeight="700.0">

    <top>
        <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="12.0">
            <padding>
                <Insets top="14.0" right="18.0" bottom="14.0" left="18.0"/>
            </padding>
            <Label text="Monte ERP" styleClass="topbar-title"/>
            <Label text="· Control de stock" styleClass="topbar-caption"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Volver" onAction="#onBack" styleClass="secondary-button"/>
        </HBox>
    </top>

    <center>
        <HBox spacing="18.0">
            <padding>
                <Insets top="18.0" right="18.0" bottom="18.0" left="18.0"/>
            </padding>

            <VBox styleClass="card" spacing="10.0" HBox.hgrow="ALWAYS">
                <padding>
                    <Insets top="18.0" right="18.0" bottom="18.0" left="18.0"/>
                </padding>

                <Label text="Stock por producto" styleClass="section-title"/>
                <Label text="Disponible = suma de los lotes. La alerta se enciende al quedar por debajo del mínimo."
                       styleClass="subtitle" wrapText="true"/>

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <TextField fx:id="searchField" promptText="Buscar por nombre o SKU"
                               HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <CheckBox fx:id="onlyBelowMinimumCheck" text="Solo bajo mínimo"/>
                </HBox>

                <TableView fx:id="levelsTable" VBox.vgrow="ALWAYS">
                    <placeholder>
                        <Label text="No hay productos que mostrar."/>
                    </placeholder>
                    <columns>
                        <TableColumn fx:id="levelProductColumn" text="Producto" prefWidth="240.0"/>
                        <TableColumn fx:id="levelSkuColumn" text="SKU" prefWidth="120.0"/>
                        <TableColumn fx:id="levelMinimumColumn" text="Mínimo" prefWidth="80.0"/>
                        <TableColumn fx:id="levelAvailableColumn" text="Disponible" prefWidth="100.0"/>
                        <TableColumn fx:id="levelAlertColumn" text="Alerta" prefWidth="120.0"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                    </columnResizePolicy>
                </TableView>

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label fx:id="alertCountLabel" styleClass="section-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Actualizar" onAction="#onRefresh" styleClass="secondary-button"/>
                </HBox>

                <Label fx:id="errorLabel" styleClass="error" wrapText="true"/>
            </VBox>

            <VBox styleClass="card" spacing="8.0" prefWidth="420.0" minWidth="360.0">
                <padding>
                    <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
                </padding>

                <Label text="Lotes del producto" styleClass="title"/>
                <Label text="Selecciona un producto para ver el detalle de sus lotes."
                       styleClass="subtitle" wrapText="true"/>

                <TableView fx:id="lotsTable" VBox.vgrow="ALWAYS">
                    <placeholder>
                        <Label text="Selecciona un producto para ver sus lotes."/>
                    </placeholder>
                    <columns>
                        <TableColumn fx:id="lotEntryDateColumn" text="Entrada" prefWidth="140.0"/>
                        <TableColumn fx:id="lotInitialColumn" text="Inicial" prefWidth="75.0"/>
                        <TableColumn fx:id="lotAvailableColumn" text="Disponible" prefWidth="90.0"/>
                        <TableColumn fx:id="lotPurchasePriceColumn" text="P. compra" prefWidth="95.0"/>
                        <TableColumn fx:id="lotPurchaseColumn" text="Compra" prefWidth="80.0"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </HBox>
    </center>

    <bottom>
        <HBox styleClass="statusbar" alignment="CENTER_LEFT">
            <padding>
                <Insets top="8.0" right="18.0" bottom="8.0" left="18.0"/>
            </padding>
            <Label fx:id="countLabel" styleClass="statusbar-text"/>
        </HBox>
    </bottom>
</BorderPane>
